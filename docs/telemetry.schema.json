{
  "$defs": {
    "GPS": {
      "additionalProperties": false,
      "properties": {
        "fix": {
          "default": false,
          "title": "Fix",
          "type": "boolean"
        },
        "source": {
          "default": "NONE",
          "enum": [
            "GPS",
            "SIMULATED",
            "NONE"
          ],
          "title": "Source",
          "type": "string"
        },
        "latitude": {
          "anyOf": [
            {
              "maximum": 90,
              "minimum": -90,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latitude"
        },
        "longitude": {
          "anyOf": [
            {
              "maximum": 180,
              "minimum": -180,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Longitude"
        },
        "speed_kmph": {
          "anyOf": [
            {
              "maximum": 400,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Speed Kmph"
        },
        "satellites": {
          "default": 0,
          "maximum": 99,
          "minimum": 0,
          "title": "Satellites",
          "type": "integer"
        },
        "age_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Age S"
        }
      },
      "title": "GPS",
      "type": "object"
    },
    "SensorHealth": {
      "additionalProperties": false,
      "properties": {
        "chamber": {
          "title": "Chamber",
          "type": "boolean"
        },
        "heatsink": {
          "title": "Heatsink",
          "type": "boolean"
        },
        "sht31": {
          "title": "Sht31",
          "type": "boolean"
        },
        "current": {
          "title": "Current",
          "type": "boolean"
        },
        "door": {
          "title": "Door",
          "type": "boolean"
        }
      },
      "required": [
        "chamber",
        "heatsink",
        "sht31",
        "current",
        "door"
      ],
      "title": "SensorHealth",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "device_id": {
      "pattern": "^[A-Za-z0-9_-]{1,48}$",
      "title": "Device Id",
      "type": "string"
    },
    "boot_id": {
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "title": "Boot Id",
      "type": "string"
    },
    "sequence": {
      "minimum": 0,
      "title": "Sequence",
      "type": "integer"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "uptime_ms": {
      "minimum": 0,
      "title": "Uptime Ms",
      "type": "integer"
    },
    "mode": {
      "enum": [
        "SIMULATION",
        "HARDWARE"
      ],
      "title": "Mode",
      "type": "string"
    },
    "chamber_temp_c": {
      "anyOf": [
        {
          "maximum": 125,
          "minimum": -55,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Chamber Temp C"
    },
    "heatsink_temp_c": {
      "anyOf": [
        {
          "maximum": 125,
          "minimum": -55,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Heatsink Temp C"
    },
    "sht31_temp_c": {
      "anyOf": [
        {
          "maximum": 125,
          "minimum": -40,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Sht31 Temp C"
    },
    "humidity_pct": {
      "anyOf": [
        {
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Humidity Pct"
    },
    "primary_current_a": {
      "anyOf": [
        {
          "maximum": 20,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Primary Current A"
    },
    "door_open": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "title": "Door Open"
    },
    "door_open_s": {
      "default": 0,
      "minimum": 0,
      "title": "Door Open S",
      "type": "number"
    },
    "gps": {
      "$ref": "#/$defs/GPS"
    },
    "primary_cooling": {
      "title": "Primary Cooling",
      "type": "boolean"
    },
    "backup_cooling": {
      "title": "Backup Cooling",
      "type": "boolean"
    },
    "system_state": {
      "enum": [
        "NORMAL",
        "WARNING",
        "PRIMARY_FAULT",
        "BACKUP_ACTIVE",
        "RECOVERY",
        "CRITICAL_FAILURE",
        "REROUTING"
      ],
      "title": "System State",
      "type": "string"
    },
    "sensor_health": {
      "$ref": "#/$defs/SensorHealth"
    },
    "fault_injection": {
      "default": "NONE",
      "enum": [
        "NONE",
        "PRIMARY_FAILURE",
        "BACKUP_FAILURE"
      ],
      "title": "Fault Injection",
      "type": "string"
    },
    "buffered": {
      "default": false,
      "title": "Buffered",
      "type": "boolean"
    }
  },
  "required": [
    "device_id",
    "boot_id",
    "sequence",
    "timestamp",
    "uptime_ms",
    "mode",
    "chamber_temp_c",
    "heatsink_temp_c",
    "sht31_temp_c",
    "humidity_pct",
    "primary_current_a",
    "door_open",
    "gps",
    "primary_cooling",
    "backup_cooling",
    "system_state",
    "sensor_health"
  ],
  "title": "Telemetry",
  "type": "object"
}
