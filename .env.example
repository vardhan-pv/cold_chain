# Cold Chain Logistics - Backend Environment Configuration

# Operator authentication token (at least 16 characters)
CC_ADMIN_TOKEN=your_secure_operator_token_here

# Database URL (SQLite or PostgreSQL)
CC_DATABASE_URL=sqlite:///runtime/cold_chain.db

# Hybrid demonstration configuration
ENABLE_EMULATED_CURRENT=true
EMULATED_PRIMARY_CURRENT_A=3.5

# Real GIS / Mapping & Emergency Routing Providers
# (Leave empty to use free OpenStreetMap / Overpass fallback)
GOOGLE_MAPS_API_KEY=
OPENROUTESERVICE_API_KEY=
OPENROUTESERVICE_URL=https://api.heigit.org/openrouteservice/v2/directions/driving-car
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# Optional Navigation Fallback Coordinates (used ONLY if physical ESP32 GPS has no satellite lock)
DEMO_GPS_LAT=
DEMO_GPS_LNG=
